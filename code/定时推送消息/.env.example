# AI 接口配置
ANTHROPIC_API_KEY=请填写你的 API Key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=4096
REQUEST_TIMEOUT_SECONDS=180
READER_PROFILE=我是一位关注 AI 工具、产品机会、工作效率和商业化方向的中文读者。

# 邮箱配置
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SENDER_EMAIL=请填写发件邮箱
SENDER_AUTH_CODE=请填写邮箱 SMTP 授权码
RECEIVER_EMAIL=请填写收件邮箱

# 可选：覆盖新闻源或每源抓取数量
# RSS_FEEDS=https://example.com/feed1.xml,https://example.com/feed2.xml
# MAX_ITEMS_PER_FEED=5
