# 复制为 .env 后使用；程序启动时会自动加载当前目录下的 .env

# OpenAI API 密钥，配置后可启用真实转写与分析
OPENAI_API_KEY=

# OpenAI 模型配置
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini

# 抖音抓取配置，真实抓取时至少建议提供 DOUYIN_COOKIE 或 DOUYIN_COOKIE_FILE
DOUYIN_COOKIE=
DOUYIN_USER_AGENT=
DOUYIN_COOKIE_FILE=

# 本地 Windows 调试时可选，默认会优先尝试 msedge
DOUYIN_BROWSER_CHANNEL=

# 强制使用本地占位分析结果，便于本地联调
PIPELINE_FORCE_MOCK_AI=false
